#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks so the script finds lib/ even when installed as a symlink.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  if [[ "$SOURCE" != /* ]]; then
    SOURCE="$DIR/$SOURCE"
  fi
done
ROOT_DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"

# Where the code actually lives, so update/version act on the real
# checkout rather than the data directory (AGENT_HANDOFF_HOME).
export AGENT_HANDOFF_ROOT="$ROOT_DIR"

# shellcheck source=../lib/agent-handoff.sh
source "$ROOT_DIR/lib/agent-handoff.sh"

agent_handoff_main "$@"
